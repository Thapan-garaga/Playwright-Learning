{

    "default": {
        "paths": [
            "src/test/features/*.feature"
        ],
        "publishQuiet": true,
        "dryRun": false,
        "require": [
            "src/test/steps/*.ts",
            "src/test/utils/*.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "format": [
            "html:./reports/cucumber-report.html",
            "allure-cucumberjs/reports"
            
        ],
        "formatoptions": {
           "snippetInterface": "async-await",
           "resultsDir": "allure-results"
        },
        "parallel": 2,
        "retry": 1
    }


}